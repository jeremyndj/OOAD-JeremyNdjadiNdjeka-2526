<Page x:Class="WpfBestandenOefenblad.Exercises.LeesCsv"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WpfBestandenOefenblad.Exercises"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LeesCsv">

    <Grid Background="#eeeeee">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="320"/>
        </Grid.RowDefinitions>
        <Frame x:Name="fraAssignment" Grid.Row="0" Grid.Column="0" />
        <Border Background="White" Grid.Row="1">
            <!-- XAML VAN DE OEFENING -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Content="Laad verkoopcijfers" HorizontalAlignment="Left" Margin="5,5,0,0" Padding="3" Name="btnOutput" Height="24" VerticalAlignment="Top" Click="btnOutput_Click"/>
                <ListBox Grid.Row="1" Margin="10" Name="lstOutput">

                </ListBox>
                <TextBlock Grid.Row="2" Text="Totaal verkoopbedrag" Margin="10" FontWeight="SemiBold" Name="txtOutput"/>
            </Grid>
        </Border>
    </Grid>
</Page>
