<Page x:Class="WpfDokter.Views.PatientVerwijderPage"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      Title="Patiënt — verwijderen"

      Loaded="Page_Loaded">

    <Grid Margin="16">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>



        <Button Grid.Row="0"

                Content="← Terug naar patiëntenoverzicht"

                HorizontalAlignment="Left"

                Margin="0,0,0,16"

                Padding="12,6"

                Click="BtnTerug_Click"/>



        <Border Grid.Row="1"

                BorderBrush="#CCCCCC"

                BorderThickness="1"

                Background="#FAFAFA"

                Padding="20"

                HorizontalAlignment="Left"

                MinWidth="420">

            <StackPanel>

                <TextBlock x:Name="txtTitel"

                           Text="Patiënt verwijderen"

                           FontSize="20"

                           FontWeight="SemiBold"

                           Margin="0,0,0,12"/>



                <TextBlock x:Name="txtUitleg"

                           TextWrapping="Wrap"

                           Margin="0,0,0,8"

                           Foreground="#333333"/>



                <TextBlock Text="Alle afspraken van deze patiënt worden ook verwijderd."

                           TextWrapping="Wrap"

                           Margin="0,0,0,16"

                           FontStyle="Italic"

                           Foreground="#666666"/>



                <TextBlock x:Name="txtFout"

                           Foreground="DarkRed"

                           TextWrapping="Wrap"

                           Margin="0,0,0,12"

                           Visibility="Collapsed"/>



                <StackPanel Orientation="Horizontal">

                    <Button x:Name="btnVerwijderen"

                            Content="Verwijderen"

                            Padding="16,8"

                            Margin="0,0,12,0"

                            Click="BtnVerwijderen_Click"/>

                    <Button x:Name="btnAnnuleren"

                            Content="Annuleren"

                            Padding="16,8"

                            Click="BtnAnnuleren_Click"/>

                </StackPanel>

            </StackPanel>

        </Border>

    </Grid>

</Page>

