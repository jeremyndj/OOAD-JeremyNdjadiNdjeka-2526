<Page x:Class="WpfPatiënt.Views.AfsprakenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Mijn afspraken"
      Loaded="Page_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Mijn afspraken"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Overzicht van uw geplande afspraken bij de praktijk."
                           FontSize="14"
                           Foreground="#666666"/>
            </StackPanel>
            <Button x:Name="btnNieuweAfspraak"
                    Grid.Column="1"
                    Content="Nieuwe afspraak"
                    Padding="12,8"
                    VerticalAlignment="Center"
                    Click="BtnNieuweAfspraak_Click"/>
        </Grid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,12">
            <TextBlock Text="Toon:"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>
            <RadioButton x:Name="rbAlle"
                         GroupName="FilterAfspraken"
                         Content="Alle afspraken"
                         IsChecked="True"
                         Margin="0,0,16,0"
                         Checked="RbFilter_Checked"/>
            <RadioButton x:Name="rbToekomst"
                         GroupName="FilterAfspraken"
                         Content="Alleen toekomstige afspraken"
                         Checked="RbFilter_Checked"/>
        </StackPanel>

        <TextBlock x:Name="txtFout"
                   Grid.Row="2"
                   TextWrapping="Wrap"
                   Foreground="#C62828"
                   FontSize="13"
                   Visibility="Collapsed"
                   Margin="0,0,0,12"/>

        <TextBlock Grid.Row="3"
                   Text="Geplande afspraken"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

        <Border Grid.Row="4"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                Background="#FAFAFA"
                MinHeight="200">
            <ListBox x:Name="lstAfspraken"
                     BorderThickness="0"
                     Background="Transparent"
                     SelectionChanged="LstAfspraken_SelectionChanged"/>
        </Border>

        <TextBlock Grid.Row="5"
                   Text="Geselecteerde afspraak"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,16,0,8"/>

        <Border Grid.Row="6"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                Background="#FAFAFA"
                Padding="16"
                MinHeight="72">
            <TextBlock x:Name="txtDetail"
                       TextWrapping="Wrap"
                       FontSize="14"
                       Foreground="#666666"
                       Text="Selecteer een afspraak in de lijst."/>
        </Border>

        <Button x:Name="btnAnnuleren"
                Grid.Row="7"
                Content="Annuleren"
                Margin="0,16,0,0"
                Padding="16,10"
                HorizontalAlignment="Left"
                IsEnabled="False"
                Click="BtnAnnuleren_Click"/>
    </Grid>
</Page>
