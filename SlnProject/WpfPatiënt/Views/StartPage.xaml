<Page x:Class="WpfPatiënt.Views.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Start"
      Loaded="Page_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <TextBlock x:Name="txtWelkom"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Dokterspraktijk — patiëntenportaal"
                       FontSize="14"
                       Foreground="#666666"
                       Margin="0,0,0,24"/>

            <TextBlock Text="Over deze applicatie"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>
            <Border Background="#FAFAFA"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    Padding="16"
                    Margin="0,0,0,24"
                    CornerRadius="4">
                <TextBlock TextWrapping="Wrap"
                           LineHeight="22"
                           FontSize="14"
                           Text="Deze applicatie is bedoeld voor patiënten van de dokterspraktijk. Na het inloggen bekijkt u uw eigen afspraken, vraagt u nieuwe afspraken aan en beheert u uw profielgegevens. Alle gegevens komen uit de gekoppelde database en worden veilig verwerkt via de class library."/>
            </Border>

            <TextBlock Text="Wat kunt u doen?"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>
            <Border Background="#FAFAFA"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    Padding="16"
                    Margin="0,0,0,24"
                    CornerRadius="4">
                <StackPanel>
                    <TextBlock Margin="0,0,0,6"
                               TextWrapping="Wrap"
                               FontSize="14"
                               Text="• Mijn afspraken: overzicht van uw geplande afspraken bij de praktijk."/>
                    <TextBlock Margin="0,0,0,6"
                               TextWrapping="Wrap"
                               FontSize="14"
                               Text="• Afspraak maken: een nieuwe afspraak aanvragen bij een dokter."/>
                    <TextBlock Margin="0,0,0,6"
                               TextWrapping="Wrap"
                               FontSize="14"
                               Text="• Profiel: uw persoonlijke gegevens en profielfoto bekijken of wijzigen."/>
                    <TextBlock TextWrapping="Wrap"
                               FontSize="14"
                               Text="• Uitloggen: veilig afmelden via het menu links; uw sessie wordt geleegd."/>
                </StackPanel>
            </Border>

            <TextBlock Text="Snel naar"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Mijn afspraken"
                        Margin="0,0,8,0"
                        Padding="16,8"
                        Click="BtnAfspraken_Click"/>
                <Button Content="Afspraak maken"
                        Padding="16,8"
                        Click="BtnAfspraakMaken_Click"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
