<Window x:Class="WpfHelpdesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IT-Helpdesk" Height="300" Width="450"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="30" VerticalAlignment="Center">
        <TextBlock Text="Interne IT-Helpdesk"
                   FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>
        <TextBlock Text="Kies uw rol:"
                   FontSize="14"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <Button x:Name="btnMedewerker" Content="Ik ben medewerker"
                Height="40" Margin="0,5" FontSize="14"
                Click="BtnMedewerker_Click"/>
        <Button x:Name="btnHelpdesk" Content="Ik ben helpdeskmedewerker"
                Height="40" Margin="0,5" FontSize="14"
                Click="BtnHelpdesk_Click"/>
    </StackPanel>
</Window>
